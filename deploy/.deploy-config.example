# 远程服务器部署配置示例
# 复制此文件为 .deploy-config 并修改为实际配置
# 注意：.deploy-config 文件包含敏感信息，不应提交到版本控制

# 远程服务器地址（IP或域名）
REMOTE_HOST="heartsphere.cn"

# SSH端口（默认22）
REMOTE_PORT="22"

# SSH用户名
REMOTE_USER="root"

# 远程部署路径
REMOTE_PATH="/opt/heartsphere/frontend"

# SSH私钥路径（可选，留空使用默认）
# 使用绝对路径或相对于家目录的路径（如 ~/.ssh/id_rsa）
SSH_KEY=""
