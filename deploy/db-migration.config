# Database Migration Configuration
# 数据库迁移配置文件
# 
# 注意：密码等敏感信息应该通过环境变量或交互式输入提供
# 不要将密码直接写入此配置文件

# 本地数据库配置
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_NAME=heartsphere
# LOCAL_DB_PASSWORD 通过环境变量 LOCAL_DB_PASSWORD 或交互式输入提供

# 生产数据库配置
PROD_DB_HOST=rm-bp1bg7xxnka508amyvo.mysql.rds.aliyuncs.com
PROD_DB_PORT=3306
PROD_DB_USER=heartsphere
PROD_DB_NAME=heartsphere
# PROD_DB_PASSWORD 通过环境变量 PROD_DB_PASSWORD 或交互式输入提供

# 备份配置
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# 日志配置
LOG_DIR=./logs
LOG_LEVEL=INFO
