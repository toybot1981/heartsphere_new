# HeartSphere Nginx配置文件示例
# 使用说明：
# 1. 将此文件复制到 /etc/nginx/conf.d/heartsphere.conf
# 2. 修改 server_name、路径等配置项
# 3. 执行 sudo nginx -t 验证配置
# 4. 执行 sudo systemctl reload nginx 重载配置

server {
    listen 80;
    server_name your-domain.com www.your-domain.com;

    # 日志配置
    access_log /var/log/nginx/heartsphere-access.log;
    error_log /var/log/nginx/heartsphere-error.log;

    # 文件上传大小限制
    client_max_body_size 50M;

    # 后端API代理
    location /api/ {
        proxy_pass http://localhost:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 缓冲设置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # 图片文件服务（新路径结构：/images/**）
    # 方式1: 静态文件服务（推荐，性能更好）
    location /images/ {
        # 修改为实际的后端uploads/images目录路径
        alias /path/to/heartsphere/backend/uploads/images/;
        
        # 缓存配置
        expires 30d;
        add_header Cache-Control "public, immutable";
        
        # 允许跨域（如果需要）
        add_header Access-Control-Allow-Origin *;
        
        # 禁止访问隐藏文件
        location ~ /\. {
            deny all;
            access_log off;
            log_not_found off;
        }
        
        # 可选：只允许图片文件类型
        # location ~* \.(jpg|jpeg|png|gif|webp|svg)$ {
        #     expires 30d;
        #     add_header Cache-Control "public, immutable";
        # }
    }

    # 方式2: 通过后端代理（如果后端处理文件服务，取消注释以下配置）
    # location /images/ {
    #     proxy_pass http://localhost:8081/images/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     
    #     # 缓存配置
    #     proxy_cache_valid 200 30d;
    #     proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    # }

    # 前端静态文件
    location / {
        # 修改为实际的前端dist目录路径
        root /path/to/heartsphere/frontend/dist;
        try_files $uri $uri/ /index.html;
        
        # 缓存配置
        expires 1h;
        add_header Cache-Control "public";
        
        # 禁止访问隐藏文件
        location ~ /\. {
            deny all;
            access_log off;
            log_not_found off;
        }
    }

    # 健康检查端点（可选）
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

