{
  "metadata": {
    "created_at": "2026-01-28T00:00:00Z",
    "app_url": "http://localhost:3005/admin",
    "test_scope": "技能管理自动化测试（登录、专业创建器全流程：AI 生成、文件导入、方式切换、手动编辑、基础信息→元数据→指令→MCP→执行→资源→预览→完成创建）",
    "priority": "high",
    "prerequisites": [
      "Admin 前端运行在 http://localhost:3005/admin",
      "Admin 后端运行在 http://localhost:8085",
      "管理员账号：admin / 指定密码（如 Tyx@19811009）",
      "如需 AI 生成：Main 服务（如 8081）已启动，且 Admin 已配置访问 Main 的 API Key",
      "Python 3.8+ 和 Playwright 已安装",
      "web-automation-testing 技能可用"
    ],
    "notes": [
      "本测试计划针对 Admin 技能管理专业创建器",
      "使用中文 UI，步骤使用 text= 或稳定选择器",
      "失败时可自动检查 admin 前后端日志，并使用 scripts/start/ 下脚本重启服务"
    ]
  },
  "requirements": [
    "管理员可以登录管理端",
    "管理员可以进入技能管理并打开专业创建器",
    "管理员可以使用 AI 生成技能",
    "管理员可以使用文件导入（粘贴/上传）",
    "管理员可以在三种创建方式之间切换",
    "管理员可以从 AI 生成/文件导入结果进入手动编辑"
  ],
  "test_suites": [
    {
      "id": "suite_login_creator",
      "name": "登录与打开创建器",
      "description": "登录管理端并进入专业创建器",
      "test_cases": ["case_1_1", "case_1_2", "case_1_3"]
    },
    {
      "id": "suite_ai_generate",
      "name": "AI 生成",
      "description": "AI 生成技能多种场景",
      "test_cases": ["case_2_1"]
    },
    {
      "id": "suite_file_import",
      "name": "文件导入",
      "description": "文件导入（粘贴/上传）",
      "test_cases": ["case_3_1"]
    },
    {
      "id": "suite_mode_switch",
      "name": "方式切换",
      "description": "三种创建方式之间切换",
      "test_cases": ["case_4_1"]
    },
    {
      "id": "suite_to_manual",
      "name": "到手动编辑",
      "description": "从 AI 生成/文件导入到手动编辑",
      "test_cases": ["case_5_1", "case_6_1"]
    },
    {
      "id": "suite_manual_flow",
      "name": "手动编辑流程",
      "description": "填写基础信息并进入下一步",
      "test_cases": ["case_7_1"]
    },
    {
      "id": "suite_wizard_steps",
      "name": "创建器向导全步骤",
      "description": "元数据、指令、MCP、执行、资源、预览与完成创建",
      "test_cases": ["case_8_1", "case_9_1", "case_10_1", "case_11_1", "case_12_1", "case_13_1"]
    },
    {
      "id": "suite_list_ops",
      "name": "技能列表操作",
      "description": "搜索、编辑、创建技能（简单表单）、编辑并更新、删除、分类筛选",
      "test_cases": ["case_14_1", "case_15_1", "case_16_1", "case_21_1", "case_17_1", "case_20_1"]
    },
    {
      "id": "suite_creator_extras",
      "name": "创建器扩展入口",
      "description": "文件导入-上传文件、手动编辑-选择模板",
      "test_cases": ["case_18_1", "case_19_1"]
    }
  ],
  "test_cases": [
    {
      "id": "case_1_1",
      "name": "登录管理端",
      "description": "使用管理员账号登录 Admin 前端",
      "steps": [
        "navigate to http://localhost:3005/admin",
        "wait for 3 seconds",
        "wait for input[type=\"text\"]",
        "type \"admin\" in input[type=\"text\"]",
        "type \"Tyx@19811009\" in input[type=\"password\"]",
        "wait for 1 second",
        "click button:has-text(\"进入系统\")",
        "wait for 5 seconds",
        "verify text=系统概览"
      ],
      "expected_result": "登录成功，页面出现系统概览或管理端主界面",
      "priority": "high",
      "status": "pending"
    },
    {
      "id": "case_1_2",
      "name": "进入技能管理",
      "description": "从侧栏 AI 智能体 进入技能管理页面",
      "steps": [
        "navigate to http://localhost:3005/admin",
        "wait for 3 seconds",
        "click text=AI 智能体",
        "wait for 2 seconds",
        "click text=技能管理",
        "wait for 5 seconds",
        "wait for text=技能管理",
        "verify text=技能管理"
      ],
      "expected_result": "进入技能管理页面，显示技能管理标题或专业创建器入口",
      "priority": "high",
      "status": "pending"
    },
    {
      "id": "case_1_3",
      "name": "打开专业创建器",
      "description": "在技能管理页面点击专业创建器",
      "steps": [
        "navigate to http://localhost:3005/admin?section=skills",
        "wait for 5 seconds",
        "click text=专业创建器",
        "wait for 5 seconds",
        "verify text=选择创建方式"
      ],
      "expected_result": "打开专业创建器，显示选择创建方式（AI 自动生成/文件导入/手动编辑）",
      "priority": "high",
      "status": "pending"
    },
    {
      "id": "case_2_1",
      "name": "AI 生成简单描述",
      "description": "使用简单描述触发 AI 生成技能",
      "steps": [
        "navigate to http://localhost:3005/admin?section=skills",
        "wait for 5 seconds",
        "click text=专业创建器",
        "wait for 3 seconds",
        "click text=AI 自动生成",
        "wait for 2 seconds",
        "wait for textarea",
        "type \"一个查询天气的技能\" in textarea",
        "wait for 1 second",
        "click button:has-text(\"生成技能\")",
        "wait for 30 seconds",
        "verify text=技能生成成功"
      ],
      "expected_result": "AI 生成成功，页面显示技能生成成功提示",
      "priority": "high",
      "status": "pending"
    },
    {
      "id": "case_3_1",
      "name": "文件导入粘贴",
      "description": "通过粘贴 JSON 内容导入技能",
      "steps": [
        "navigate to http://localhost:3005/admin?section=skills",
        "wait for 5 seconds",
        "click text=专业创建器",
        "wait for 3 seconds",
        "click text=文件导入",
        "wait for 3 seconds",
        "click text=粘贴内容",
        "wait for 2 seconds",
        "wait for textarea",
        "type \"{\\\"skillId\\\":\\\"test-paste-1\\\",\\\"name\\\":\\\"测试粘贴\\\",\\\"description\\\":\\\"测试\\\"}\" in textarea",
        "wait for 1 second",
        "click button:has-text(\"导入\")",
        "wait for 5 seconds",
        "verify text=test-paste-1"
      ],
      "expected_result": "解析成功，显示 skillId 或技能字段",
      "priority": "high",
      "status": "pending"
    },
    {
