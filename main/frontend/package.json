{
  "name": "心域-heartsphere",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --config=e2e/config/playwright.config.ts",
    "test:e2e:pc": "playwright test --config=e2e/config/playwright.config.ts e2e/tests/pc",
    "test:e2e:mobile": "playwright test --config=e2e/config/playwright.config.ts e2e/tests/mobile",
    "test:e2e:ui": "playwright test --config=e2e/config/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report e2e/reports/html",
    "analyze:bundle": "node scripts/check-bundle-size.js",
    "build:analyze": "npm run build && npm run analyze:bundle",
    "check:quality": "bash scripts/check-code-quality.sh",
    "check:types": "tsc --noEmit --skipLibCheck",
    "cap:build": "npm run build && npx cap sync",
    "cap:build:android": "bash scripts/build-android.sh",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios"
  },
  "dependencies": {
    "@antv/x6": "^3.1.4",
    "@antv/x6-plugin-minimap": "^3.0.0",
    "@antv/x6-react-components": "^2.0.9",
    "@antv/x6-react-shape": "^3.0.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^1.30.0",
    "@mui/material": "^7.3.6",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.182.0",
    "antd": "^6.1.3",
    "framer-motion": "^12.24.12",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "reactflow": "^11.11.4",
    "three": "^0.182.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "~5.8.2",
    "vite": "^5.0.0"
  }
}
