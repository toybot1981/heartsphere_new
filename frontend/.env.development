# 部署环境
VITE_DEPLOY_ENV=development

# API 基础URL配置
# Development 环境默认使用 http://localhost:8081
VITE_API_BASE_URL=http://localhost:8081

# 大模型 API Key 配置（从主环境变量文件读取）
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_QWEN_API_KEY=
VITE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VITE_DOUBAO_API_KEY=
VITE_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型名称配置
VITE_GEMINI_MODEL_NAME=gemini-2.5-flash
VITE_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
VITE_GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
VITE_OPENAI_MODEL_NAME=gpt-4o
VITE_OPENAI_IMAGE_MODEL=dall-e-3
VITE_QWEN_MODEL_NAME=qwen-max
VITE_QWEN_IMAGE_MODEL=qwen-image-plus
VITE_QWEN_VIDEO_MODEL=wanx-video
VITE_DOUBAO_MODEL_NAME=ep-2024...
VITE_DOUBAO_IMAGE_MODEL=doubao-image-v1
VITE_DOUBAO_VIDEO_MODEL=doubao-video-v1

# 路由策略配置
VITE_TEXT_PROVIDER=gemini
VITE_IMAGE_PROVIDER=gemini
VITE_VIDEO_PROVIDER=gemini
VITE_AUDIO_PROVIDER=gemini
VITE_ENABLE_FALLBACK=true
