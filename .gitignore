# 通用忽略规则
.DS_Store
*.log
*.tmp
*.temp

# IDE配置
.idea/
.vscode/
*.iml
*.swp
*.swo

# 后端忽略规则
**/target/
**/.mvn/
**/mvnw
**/mvnw.cmd
**/*.jar
backend/application-dev.yml
backend/application-prod.yml
backend/application-test.yml

# 前端忽略规则
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# 日志目录
logs/
*.log

# 缓存目录
.cache/
.temp/

# 数据库文件
*.db
*.sqlite
*.sqlite3backend/uploads/

# 包含敏感信息的配置文件（使用环境变量替代）
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-prod.yml
backend/src/main/resources/application-*.local.yml
**/.env
**/.env.local
**/.env.*.local
**/*secret*.yml
**/*secret*.properties
**/*password*.yml
**/*password*.properties
heartsphere-service-*.jar
*.jar
node_modules

# 数据库备份文件
sql/backups/
*.pid
*.bak
__pycache__/
*.pyc

# 排除备份 SQL 文件，但保留迁移脚本
sql/*.sql
!sql/clean*.sql
.build-cache/
.deps-cache/
